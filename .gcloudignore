# Upload only what the Dockerfile uses. Without this, `gcloud run deploy
# --source .` would upload the datasets and the local Python environment.
*
!Dockerfile
!requirements-server.txt
!app.py
!src/
src/*
!src/model.py
!models/
models/*
!models/wound_model.keras
!models/class_names.json
!templates/
!templates/**
